<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shares a container with MihrabWatchWidgets *on the watch*. The
	     identically-named group on the iPhone is a separate container on a
	     separate device — the two are never the same store, which is why the
	     phone link is WatchConnectivity and not this. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.caferkarakaya.mihrab</string>
	</array>
</dict>
</plist>
