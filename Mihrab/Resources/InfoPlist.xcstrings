    "NSAlarmKitUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم رواق المنبّهات ليُسمَع الأذان في وقته، حتى في الوضع الصامت أو أثناء التركيز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revak uses alarms so the adhan can sound at prayer time, even in Silent mode or Focus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revak, ezanın namaz vaktinde Sessiz modda ve Odak açıkken bile duyulabilmesi için alarm kullanır."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم الكاميرا فقط لإظهار اتجاه القبلة بالواقع المعزز. لا يتم التسجيل أو الرفع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera is used only to show Qibla direction in AR. Nothing is recorded or uploaded."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera yalnızca AR kıble yönü için kullanılır. Kayıt veya yükleme yoktur."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم رواق موقعك لحساب أوقات الصلاة الدقيقة واتجاه القبلة والمساجد القريبة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revak uses your location to calculate precise prayer times, Qibla direction, and nearby mosques."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revak konumunu hassas namaz vakitleri, kıble yönü ve yakındaki camiler için kullanır."
          }
        }
      }
    }
  },
  "version" : "1.0"
}