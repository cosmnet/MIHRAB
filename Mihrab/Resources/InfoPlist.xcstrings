    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم الكاميرا فقط لإظهار اتجاه القبلة بالواقع المعزز. لا يتم التسجيل أو الرفع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera is used only to show Qibla direction in AR. Nothing is recorded or uploaded."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera yalnızca AR kıble yönü için kullanılır. Kayıt veya yükleme yoktur."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم محراب موقعك لحساب أوقات الصلاة الدقيقة واتجاه القبلة والمساجد القريبة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mihrab uses your location to calculate precise prayer times, Qibla direction, and nearby mosques."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mihrab konumunu hassas namaz vakitleri, kıble yönü ve yakındaki camiler için kullanır."
          }
        }
      }
    }
  },
  "version" : "1.0"
