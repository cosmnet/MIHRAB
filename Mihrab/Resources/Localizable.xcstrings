    "Add the Mihrab widget to your Home Screen, Lock Screen, and Dynamic Island. You can set it up later in Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف ودجة محراب إلى الشاشة الرئيسية وشاشة القفل والجزيرة الديناميكية. يمكنك إعدادها لاحقاً من الإعدادات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the Mihrab widget to your Home Screen, Lock Screen, and Dynamic Island. You can set it up later in Settings."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mihrab pencere öğesini Ana Ekran, Kilit Ekranı ve Dynamic Island’a ekle. Bunu sonra Ayarlar’dan yapabilirsin."
          }
        }
      }
    },
    "Adds to today's dhikr count without opening the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
